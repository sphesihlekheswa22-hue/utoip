FLASK_ENV=development
SECRET_KEY=uitop-dev-secret-change-in-production
JWT_SECRET_KEY=uitop-jwt-dev-secret-change-in-production
# Local Postgres:
# DATABASE_URL=postgresql+psycopg2://uitop:uitop@localhost:5432/uitop
# Render sets DATABASE_URL automatically when linked to Postgres (postgres:// is normalized in config).
DEMO_MODE=true
CORS_ORIGINS=*
# Render: set to https://your-app.onrender.com or keep * for agent API from LAN

# IT Copilot — OpenRouter (recommended; free models available)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=UITOP IT Copilot

# Optional: direct OpenAI instead of OpenRouter
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
